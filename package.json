{
  "name": "openaflow",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @openaflow/server --filter @openaflow/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm -r build && pnpm --filter @openaflow/server bundle",
    "start": "node packages/server/dist/app/server.mjs",
    "desktop": "pnpm --filter @openaflow/desktop start",
    "test:electron": "node packages/desktop/scripts/real-tests.mjs",
    "package": "pnpm --filter @openaflow/desktop package",
    "test:install": "node packages/desktop/scripts/install-tests.mjs",
    "release:check": "pnpm --filter @openaflow/desktop exec tsx scripts/release-check.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
